{
  "name": "love-life-admin",
  "version": "0.2.0",
  "description": "情侣生活记录后台管理台，基于 SoybeanAdmin（Vue3 + Vite + TypeScript + NaiveUI + UnoCSS）",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "dev": "vp dev --mode prod",
    "build": "vp build --mode prod",
    "preview": "vp preview --mode prod",
    "gen-route": "pnpm sa gen-route",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "lint": "vp lint --fix && eslint --fix .",
    "lint:gate": "eslint src --max-warnings=0",
    "guard": "node scripts/guard-styles.mjs",
    "verify": "pnpm run typecheck && pnpm run lint:gate && pnpm run guard",
    "fmt": "vp fmt"
  },
  "dependencies": {
    "@better-scroll/core": "2.5.1",
    "@iconify/vue": "5.0.3",
    "@sa/color": "workspace:*",
    "@sa/hooks": "workspace:*",
    "@sa/materials": "workspace:*",
    "@sa/utils": "workspace:*",
    "@vueuse/core": "15.0.0",
    "clipboard": "2.0.11",
    "dayjs": "1.11.23",
    "defu": "6.1.7",
    "lucide-vue-next": "^1.0.0",
    "naive-ui": "2.45.3",
    "nprogress": "0.2.0",
    "pinia": "4.0.3",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.43",
    "vue-i18n": "11.4.13",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@elegant-router/vue": "0.3.8",
    "@iconify/json": "2.2.541",
    "@iconify/utils": "3.1.7",
    "@sa/scripts": "workspace:*",
    "@sa/uno-preset": "workspace:*",
    "@soybeanjs/eslint-config-vue": "^0.1.1",
    "@soybeanjs/oxc-config": "^0.2.6",
    "@types/node": "^26.6.4",
    "@types/nprogress": "0.2.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "consola": "3.4.2",
    "eslint": "^10.12.0",
    "kolorist": "1.8.0",
    "sass": "1.105.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "unocss": "^66.10.5",
    "unplugin-icons": "24.0.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "catalog:",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "8.2.1",
    "vite-plugin-vue-transition-root-validator": "^0.1.0",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.5.0"
  }
}
